async def handle_admin_input(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
  if (
      context.user_data.get("adding_product")
      and update.effective_user.id == ADMIN_ID
  ):
    text = update.message.text
    try:
      parts = [p.strip() for p in text.split(",")]
      if len(parts) < 4:
        raise ValueError("بيانات ناقصة")

      name, price, desc, category = parts[0], float(parts[1]), parts[2], parts[3]

      conn = sqlite3.connect("store.db")
      cursor = conn.cursor()
      cursor.execute(
          "INSERT INTO products (name, price, description, category) VALUES"
          " (?, ?, ?, ?)",
          (name, price, desc, category),
      )
      conn.commit()
      conn.close()

      context.user_data["adding_product"] = False
      await update.message.reply_text(
          "✅ تمت إضافة المنتج بنجاح!",
          reply_markup=InlineKeyboardMarkup(
              [[InlineKeyboardButton("⚙️ لوحة التحكم", callback_data="admin_panel")]]
          ),
      )
    except Exception:
      await update.message.reply_text(
          "❌ حدث خطأ في تنسيق البيانات. تأكد من استخدام الفاصلة (,) بالشكل"
          " الصحيح وأعد المحاولة."
      )


async def admin_del_prod_list(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
  query = update.callback_query
  await query.answer()

  conn = sqlite3.connect("store.db")
  cursor = conn.cursor()
  cursor.execute("SELECT id, name FROM products")
  products = cursor.fetchall()
  conn.close()

  if not products:
    await query.message.edit_text(
        "لا توجد منتجات لحذفها.",
        reply_markup=InlineKeyboardMarkup(
            [[InlineKeyboardButton("🔙 لوحة التحكم", callback_data="admin_panel")]]
        ),
    )
    return

  keyboard = []
  for p in products:
    keyboard.append([
        InlineKeyboardButton(
            f"🗑️ حذف: {p[1]}", callback_data=f"admin_rm_{p[0]}"
        )
    ])
  keyboard.append(
      [InlineKeyboardButton("🔙 لوحة التحكم", callback_data="admin_panel")]
  )

  await query.message.edit_text(
      "اختر المنتج المراد حذفه:", reply_markup=InlineKeyboardMarkup(keyboard)
  )


async def admin_remove_product(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
  query = update.callback_query
  await query.answer("تم حذف المنتج")
  prod_id = int(query.data.split("_")[2])

  conn = sqlite3.connect("store.db")
  cursor = conn.cursor()
  cursor.execute("DELETE FROM products WHERE id = ?", (prod_id,))
  conn.commit()
  conn.close()

  await admin_del_prod_list(update, context)


async def back_home(update: Update, context: ContextTypes.DEFAULT_TYPE):
  query = update.callback_query
  await query.answer()
  context.user_data["waiting_for_name"] = False
  context.user_data["adding_product"] = False

  keyboard = [
      [InlineKeyboardButton("🛍️ استعراض المنتجات", callback_data="show_categories")],
      [InlineKeyboardButton("🛒 سلة المشتريات", callback_data="show_cart")],
  ]
  if update.effective_user.id == ADMIN_ID:
    keyboard.append(
        [InlineKeyboardButton("⚙️ لوحة التحكم (أدمن)", callback_data="admin_panel")]
    )

  await query.message.edit_text(
      "القائمة الرئيسية:", reply_markup=InlineKeyboardMarkup(keyboard)
  )


def main():
  app = ApplicationBuilder().token(TOKEN).build()

  app.add_handler(CommandHandler("start", start))
  app.add_handler(CallbackQueryHandler(show_categories, pattern="^show_categories$"))
  app.add_handler(CallbackQueryHandler(show_products_in_cat, pattern="^cat_"))
  app.add_handler(CallbackQueryHandler(product_detail, pattern="^prod_"))
  app.add_handler(CallbackQueryHandler(add_to_cart, pattern="^add_cart_"))
  app.add_handler(CallbackQueryHandler(show_cart, pattern="^show_cart$"))
  app.add_handler(CallbackQueryHandler(delete_from_cart, pattern="^del_cart_"))
  app.add_handler(CallbackQueryHandler(checkout, pattern="^checkout$"))
  app.add_handler(CallbackQueryHandler(back_home, pattern="^back_home$"))

  app.add_handler(CallbackQueryHandler(admin_panel, pattern="^admin_panel$"))
  app.add_handler(
      CallbackQueryHandler(admin_add_prod_start, pattern="^admin_add_prod$")
  )
  app.add_handler(
      CallbackQueryHandler(admin_del_prod_list, pattern="^admin_del_prod_list$")
  )
  app.add_handler(
      CallbackQueryHandler(admin_remove_product, pattern="^admin_rm_")
  )

  app.add_handler(
      MessageHandler(
          filters.TEXT & ~filters.COMMAND,
          lambda u, c: handle_message(u, c)
          if c.user_data.get("waiting_for_name")
          else handle_admin_input(u, c),
      )
  )

  print("البوت يعمل الآن بنجاح...")
  app.run_polling()


if __name__ == "__main__":
  main()
