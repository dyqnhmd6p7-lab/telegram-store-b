# ==================== قاعدة البيانات (SQLite) ====================
def init_db():
  conn = sqlite3.connect("store.db")
  cursor = conn.cursor()
  # جدول المنتجات
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            price REAL,
            description TEXT,
            category TEXT
        )
    """)
  # جدول السلة المؤقتة لكل مستخدم
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS cart (
            user_id INTEGER,
            product_id INTEGER,
            quantity INTEGER
        )
    """)
  conn.commit()
  conn.close()


init_db()


