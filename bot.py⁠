# عرض الأقسام أو المنتجات
async def show_categories(update: Update, context: ContextTypes.DEFAULT_TYPE):
  query = update.callback_query
  await query.answer()

  conn = sqlite3.connect("store.db")
  cursor = conn.cursor()
  cursor.execute("SELECT DISTINCT category FROM products")
  categories = cursor.fetchall()
  conn.close()

  if not categories:
    await query.message.edit_text(
        "عذراً، لا توجد منتجات مضافة حالياً.",
        reply_markup=InlineKeyboardMarkup(
            [[InlineKeyboardButton("🔙 رجوع", callback_data="back_home")]]
        ),
    )
    return

  keyboard = []
  for cat in categories:
    keyboard.append(
        [InlineKeyboardButton(f"📁 {cat[0]}", callback_data=f"cat_{cat[0]}")]
    )
  keyboard.append(
      [InlineKeyboardButton("🔙 رجوع للرئيسية", callback_data="back_home")]
  )

  await query.message.edit_text(
      "اختر القسم المطلوب:", reply_markup=InlineKeyboardMarkup(keyboard)
  )


